# Set only on the server. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Local development without DATABASE_URL uses the existing local preview.
# Production without DATABASE_URL fails explicitly unless preview is requested.
ONE_DAY_PREVIEW=0
# Optional CA certificate path for a self-hosted PostgreSQL with a private CA.
PGSSLROOTCERT=
# Or put the private CA certificate in an environment variable (base64 PEM).
# Do not add sslmode/sslrootcert query parameters to DATABASE_URL with this option.
PGSSL_CA_BASE64=
# Required for publishing, including local preview. Server only.
MODERATION_API_KEY=
MODERATION_BASE_URL=https://api.deepseek.com
MODERATION_MODEL=deepseek-flash
# At least 32 random characters; same secret across deployment instances.
ANONYMOUS_COOKIE_SECRET=
# Only for phone testing on your LAN; add your computer's LAN IP, comma-separated.
DEV_ALLOWED_ORIGINS=127.0.0.1
